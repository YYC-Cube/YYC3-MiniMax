{
  "name": "yyc3-ai-family-command-center",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "description": "YYC³ AI FAMILY 漫剧工业化指挥中心 · 8 Agent 协同 / ReAct-C 九步闭环 / PWA",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "vitest",
    "pnpm",
    "pwa",
    "service-worker",
    "spa",
    "offline-first",
    "ai-agent",
    "multi-agent-orchestration",
    "react-c",
    "command-center",
    "realtime-dashboard",
    "data-visualization",
    "svg-animation",
    "github-pages",
    "ai-family",
    "yyc3"
  ],
  "homepage": "https://minimax.yyc3.top",
  "repository": {
    "type": "git",
    "url": "https://github.com/YYC-Cube/YYC3-MiniMax.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:icons": "vitest run tests/icons.test.ts",
    "test:i18n": "vitest run tests/i18n.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "madge:circular": "madge --circular --extensions ts,tsx src",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "budget": "node scripts/bundle-budget.mjs",
    "audit:lighthouse": "pnpm dlx @lhci/cli@0.15 autorun",
    "soak:clinic": "pnpm dlx clinic doctor -- pnpm dev",
    "preview": "npx serve out",
    "format": "oxfmt"
  },
  "knip": {
    "ignoreExportsUsedInFile": true,
    "ignore": [
      "public/sw.js",
      "lighthouserc.cjs"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "web-vitals": "^6.2.3"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": ">=1.2.2"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.41.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
